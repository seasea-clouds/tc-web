{
  "name": "@trade/blog",
  "version": "6.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../../packages/scripts/inject-version.mjs",
    "build": "node ../../packages/scripts/build-search-index.mjs && rm -rf .next/cache && next build && node ../../packages/scripts/ci-check.mjs --out-dir=out --ci",
    "build:ci": "node ../../packages/scripts/build-search-index.mjs && rm -rf .next/cache && next build && node ../../packages/scripts/ci-check.mjs --out-dir=out --ci",
    "start": "next start",
    "deploy": "npx wrangler pages deploy ./out --project-name=trade-web-blog",
    "lint": "next lint"
  },
  "dependencies": {
    "@trade/ui": "^from ../../VERSION",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.24.0",
    "next": "^16",
    "next-intl": "^4.13.2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
