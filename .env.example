# SinoTrade Compliance — Environment Variables Guide
# ============================================
# Copy to .env.local and fill values for local dev.
# In Cloudflare, set via Pages Dashboard > Environment Variables.
# Each Pages project should ONLY have vars it actually needs.
# See per-project assignment at bottom.
# ============================================
# -- Cloudflare API (analytics-cron standalone Worker) --
# Set via: npx wrangler secret put, NOT in Pages env vars.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# -- D1 Database ID (for generating analytics-cron wrangler.toml) --
D1_DATABASE_ID=
# -- Admin Dashboard (trade-web-admin Pages) --
ADMIN_JWT_SECRET=
TURNSTILE_SECRET_KEY=
# -- Portal (trade-web-portal Pages) --
CREEM_API_KEY=
CREEM_PRODUCT_ID_SINGLE=
CREEM_PRODUCT_ID_SUBSCRIBE=
CREEM_WEBHOOK_SECRET=
EMAIL_FROM=
JWT_SECRET=
RESEND_API_KEY=
# -- Main Site Edge Worker (trade-web-site Pages) --
UPSTREAM_BLOG=
UPSTREAM_PORTAL=
# -- Site + Blog contact forms --
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
# -- Build Config --
NODE_VERSION=22
# ======== Per-Project Assignment ========
# trade-web-admin (prod):
#   ADMIN_JWT_SECRET       — JWT signing for admin login
#   TURNSTILE_SECRET_KEY   — Turnstile CAPTCHA verification
#
# trade-web-portal:
#   CREEM_API_KEY           — Creem payment processing
#   CREEM_PRODUCT_ID_SINGLE — Creem single product ID
#   CREEM_PRODUCT_ID_SUBSCRIBE — Creem subscription product ID
#   CREEM_WEBHOOK_SECRET    — Creem webhook signature verification
#   EMAIL_FROM              — Sender address
#   JWT_SECRET              — JWT signing for user sessions
#   RESEND_API_KEY          — Email sending via Resend
#   TURNSTILE_SECRET_KEY    — Turnstile CAPTCHA verification
#
# trade-web-site:
#   UPSTREAM_BLOG           — Blog Pages URL for Edge Worker proxy
#   UPSTREAM_PORTAL         — Portal Pages URL for Edge Worker proxy
#   NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY — Web3Forms form handler key
#
# trade-web-blog:
#   NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY — Web3Forms form handler key
#
# analytics-cron standalone Worker (via wrangler secret put):
#   CLOUDFLARE_API_TOKEN    — CF API token (needs analytics:read scope)
#   CLOUDFLARE_ZONE_ID      — CF zone ID for sinotradecompliance.com
#   D1 binding: env.DB
# ============================================
