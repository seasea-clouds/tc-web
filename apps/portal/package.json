{
  "name": "@trade/portal",
  "version": "6.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../../packages/scripts/inject-version.mjs",
    "build": "node ../../packages/scripts/build-search-index.mjs && next build && node ../../packages/scripts/ci-check.mjs --out-dir=out",
    "build:ci": "node ../../packages/scripts/build-search-index.mjs && next build && node ../../packages/scripts/ci-check.mjs --out-dir=out --ci",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npx wrangler pages deploy ./out --project-name=trade-web-portal",
    "postdeploy-check": "sleep 30 && node ../../packages/scripts/check-hreflang-portal.mjs --ci"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@trade/ui": "^from ../../VERSION",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "next-intl": "^4.13.2",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "gray-matter": "^4.0.3",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
